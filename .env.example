TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alertas no Discord (Configurações do canal → Integrações → Webhooks)
DISCORD_WEBHOOK_URL=
# Painel lendo da API em vez dos arquivos de outputs/
HM_API_URL=
